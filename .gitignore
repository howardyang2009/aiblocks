.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SECRETS — never commit real keys
.env
.env.local
.env*.local
.env*

# vercel / supabase local
.vercel
.supabase

# supabase
/supabase/.temp
/supabase/.branches

# playwright e2e
