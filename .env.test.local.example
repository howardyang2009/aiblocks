# ----------------------------------------------------------
# AiBlocks — e2e test environment
# Copy this file to .env.test.local (gitignored). Loaded by
# playwright.config.ts and by `npm run dev:test` (NODE_ENV=test), NEVER by
# `npm run dev` — real dev credentials in .env.local are never touched by
# the e2e suite.
# ----------------------------------------------------------

# --- Clerk ---
# The SAME test-mode (pk_test_/sk_test_) keys from your regular .env.local
# work here — Clerk's Playwright testing token bypass only needs a dev
# instance, not a separate project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# One dedicated test user, created once by hand in the Clerk dashboard
# (Users -> Create user). No password needed — auth.setup.ts signs in via
# clerk.signIn({ page, emailAddress }), a Backend-API sign-in ticket, not a
# first-factor flow. See e2e/README.md.
CLERK_TEST_USER_EMAIL=e2e-test-user@example.com

# --- Supabase (local, via `supabase start`) ---
# These vary by Supabase CLI version and project — do NOT reuse the values
# below verbatim. After `supabase start` (or `supabase status` if it's
# already running), copy its printed API_URL, ANON_KEY, and
# SERVICE_ROLE_KEY (the JWT-style keys, not the newer sb_publishable_/
# sb_secret_ ones — this codebase's Supabase clients expect the JWT format).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-ANON_KEY-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=paste-the-SERVICE_ROLE_KEY-from-supabase-status
SUPABASE_ZIP_BUCKET=component-zips

# --- Stripe ---
# Dummy value: nothing in the e2e suite exercises checkout (deferred — see
# e2e/README.md), and getStripe() only throws if actually called.
STRIPE_SECRET_KEY=sk_test_dummy_not_used_by_e2e
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy_not_used_by_e2e
STRIPE_WEBHOOK_SECRET=whsec_dummy_not_used_by_e2e

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
